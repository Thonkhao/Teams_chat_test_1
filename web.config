<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <defaultDocument>
            <files>
                <!-- remove ก่อน add — ถ้า IIS มี index.php อยู่แล้ว การ add ซ้ำจะทำให้ error 500.19 -->
                <remove value="index.php" />
                <add value="index.php" />
            </files>
        </defaultDocument>
    </system.webServer>
</configuration>
